{
  "name": "@react-native-gamekit/playground",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "expo:prebuild": "expo prebuild",
    "expo:prebuild:clean": "expo prebuild --clean",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test \"src/**/*.test.ts\" && node --import tsx --experimental-test-module-mocks --test \"src/**/*.test.tsx\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test \"src/**/*.test.ts\" && node --import tsx --experimental-test-module-mocks --experimental-test-coverage --test \"src/**/*.test.tsx\""
  },
  "dependencies": {
    "@expo/ui": "catalog:native",
    "@shopify/react-native-skia": "catalog:native",
    "expo": "catalog:native",
    "expo-asset": "catalog:native",
    "expo-audio": "catalog:native",
    "expo-dev-client": "catalog:native",
    "expo-haptics": "catalog:native",
    "expo-status-bar": "catalog:native",
    "react": "catalog:native",
    "react-dom": "catalog:native",
    "react-native": "catalog:native",
    "react-native-gesture-handler": "catalog:native",
    "react-native-reanimated": "catalog:native",
    "react-native-safe-area-context": "catalog:native",
    "react-native-worklets": "catalog:native",
    "rn-gamekit": "workspace:*",
    "zustand": "5.0.14",
    "@react-native-async-storage/async-storage": "catalog:native",
    "react-native-audio-api": "catalog:native",
    "react-native-pulsar": "catalog:native"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "catalog:native",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "catalog:native",
    "react-test-renderer": "catalog:native",
    "tsx": "^4.23.6",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
