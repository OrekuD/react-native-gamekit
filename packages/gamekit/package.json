{
  "name": "react-native-gamekit",
  "version": "0.0.0",
  "description": "A headless-first 2D game toolkit for React Native and Expo, built for mobile and tablet.",
  "license": "MIT",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./react": {
      "types": "./lib/typescript/src/react.d.ts",
      "default": "./lib/module/react.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./lib/typescript/src/testing.d.ts",
      "default": "./lib/module/testing.js"
    }
  },
  "react-native": "./lib/module/index.js",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test test/*.test.ts",
    "prepack": "bob build",
    "pack:inspect": "pnpm pack --dry-run",
    "bench:deepfreeze": "node --import tsx bench/deepFreeze.bench.ts",
    "test:coverage:gate": "node scripts/coverage-gate.mjs"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "2.11.0",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "react": "^19.2.3",
    "react-native": "~0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.3"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.0",
    "expo": "57.0.10",
    "expo-asset": "57.0.8",
    "expo-audio": "57.0.3",
    "expo-haptics": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.10.3",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
