{
  "name": "rn-gamekit",
  "version": "0.1.0",
  "description": "A headless-first 2D game toolkit for React Native and Expo, built for mobile and tablet.",
  "license": "MIT",
  "keywords": [
    "react-native",
    "expo",
    "game-engine",
    "game-development",
    "2d",
    "skia"
  ],
  "homepage": "https://github.com/OrekuD/react-native-gamekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrekuD/react-native-gamekit.git",
    "directory": "packages/gamekit"
  },
  "bugs": {
    "url": "https://github.com/OrekuD/react-native-gamekit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/module/index.js",
  "source": "./src/index.ts",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./react": {
      "react-native": "./src/react.ts",
      "source": "./src/react.ts",
      "types": "./lib/typescript/src/react.d.ts",
      "default": "./lib/module/react.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "react-native": "./src/testing.ts",
      "source": "./src/testing.ts",
      "types": "./lib/typescript/src/testing.d.ts",
      "default": "./lib/module/testing.js"
    },
    "./audio": {
      "react-native": "./src/audio.ts",
      "source": "./src/audio.ts",
      "types": "./lib/typescript/src/audio.d.ts",
      "default": "./lib/module/audio.js"
    },
    "./haptics": {
      "react-native": "./src/haptics.ts",
      "source": "./src/haptics.ts",
      "types": "./lib/typescript/src/haptics.d.ts",
      "default": "./lib/module/haptics.js"
    },
    "./particles": {
      "react-native": "./src/particles.ts",
      "source": "./src/particles.ts",
      "types": "./lib/typescript/src/particles.d.ts",
      "default": "./lib/module/particles.js"
    },
    "./tilemap": {
      "react-native": "./src/tilemap.ts",
      "source": "./src/tilemap.ts",
      "types": "./lib/typescript/src/tilemap.d.ts",
      "default": "./lib/module/tilemap.js"
    },
    "./geometry": {
      "react-native": "./src/geometry.ts",
      "source": "./src/geometry.ts",
      "types": "./lib/typescript/src/geometry.d.ts",
      "default": "./lib/module/geometry.js"
    },
    "./collision2d": {
      "react-native": "./src/collision2d.ts",
      "source": "./src/collision2d.ts",
      "types": "./lib/typescript/src/collision2d.d.ts",
      "default": "./lib/module/collision2d.js"
    },
    "./camera2d": {
      "react-native": "./src/camera2d.ts",
      "source": "./src/camera2d.ts",
      "types": "./lib/typescript/src/camera2d.d.ts",
      "default": "./lib/module/camera2d.js"
    },
    "./events": {
      "react-native": "./src/events.ts",
      "source": "./src/events.ts",
      "types": "./lib/typescript/src/events.d.ts",
      "default": "./lib/module/events.js"
    },
    "./assets": {
      "react-native": "./src/assets.ts",
      "source": "./src/assets.ts",
      "types": "./lib/typescript/src/assets.d.ts",
      "default": "./lib/module/assets.js"
    },
    "./sprites": {
      "react-native": "./src/sprites.ts",
      "source": "./src/sprites.ts",
      "types": "./lib/typescript/src/sprites.d.ts",
      "default": "./lib/module/sprites.js"
    },
    "./storage": {
      "react-native": "./src/storage.ts",
      "source": "./src/storage.ts",
      "types": "./lib/typescript/src/storage.d.ts",
      "default": "./lib/module/storage.js"
    }
  },
  "react-native": "./src/index.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test \"test/*.test.ts\" \"test/*.test.tsx\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test \"test/*.test.ts\" \"test/*.test.tsx\"",
    "prepack": "bob build",
    "pack:inspect": "pnpm pack --dry-run",
    "bench:deepfreeze": "node --import tsx bench/deepFreeze.bench.ts",
    "test:coverage:gate": "node scripts/coverage-gate.mjs",
    "typecheck:assets": "tsc -p tsconfig.assets.json"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@shopify/react-native-skia": "2.11.0",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "react": "^19.2.3",
    "react-native": "~0.86.2",
    "react-native-audio-api": "^0.13.3",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.5.3",
    "react-native-worklets": "0.10.3"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@shopify/react-native-skia": "2.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.0",
    "expo": "57.0.10",
    "expo-asset": "57.0.8",
    "planck": "1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "3.1.0",
    "react-native-pulsar": "1.7.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.3",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "react-native-audio-api": {
      "optional": true
    },
    "react-native-pulsar": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  }
}